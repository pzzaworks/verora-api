# Verora API configuration. Copy to .env and fill in. The API refuses to start if anything is invalid.
# Values below target Ethereum Sepolia behind a single reverse proxy (production deployment).
# For local development against Anvil, see the "Local development" notes at the end.

NODE_ENV=production
PORT=4100

DATABASE_URL=postgresql://verora:CHANGE_ME@localhost:5432/verora?schema=public

# Chain: sepolia (Ethereum Sepolia, chain 11155111) | foundry (local Anvil)
CHAIN=sepolia
# Comma-separated HTTPS endpoints, used one at a time and failed over in order when the active one
# stops answering (or a single WSS endpoint). Each needs eth_getLogs over 2000 blocks and recent state.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.rpc.sentio.xyz,https://sepolia.gateway.tenderly.co

# Contract addresses from verora-contracts/deployments/11155111.json
AGENT_REGISTRY_ADDRESS=
QUERY_CONSUMER_ADDRESS=
STAKING_POOL_ADDRESS=
REPUTATION_MANAGER_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
# Deployment block (startBlock in the manifest); the indexer starts here on an empty database
START_BLOCK=0
# The indexer follows the chain's `safe` head on Sepolia; this many extra blocks are kept as a margin
CONFIRMATIONS=3

# Background work. Exactly one instance per database runs the indexer, workers, and oracle;
# read-only replicas set all three to false.
INDEXER_ENABLED=true
WORKERS_ENABLED=true
# Oracle: the key of the address passed as FINALIZER when deploying. It only needs gas;
# never use the contract owner's key here.
ORACLE_ENABLED=true
ORACLE_PRIVATE_KEY=

# Session signing secret (at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Public URL of this API (used for hosted metadata and image URLs)
PUBLIC_BASE_URL=https://api.veroraprotocol.com
# Comma-separated browser origins allowed by CORS (SIWE message URIs must use one of them),
# and host[:port] values accepted as the SIWE domain
CORS_ORIGINS=https://veroraprotocol.com
SIWE_DOMAINS=veroraprotocol.com

SWAGGER_ENABLED=false
# Development only: allow agent endpoints on localhost/private networks (rejected when NODE_ENV=production)
ALLOW_PRIVATE_AGENT_ENDPOINTS=false
# Reverse proxies in front of the API, for client IPs in rate limiting. Required in production:
# 1 behind Coolify's Traefik (or any single proxy), 0 when the API is exposed directly.
TRUST_PROXY_HOPS=1

# Local development (Anvil from verora-contracts, Postgres from docker-compose on 5433):
# NODE_ENV=development
# DATABASE_URL=postgresql://verora:CHANGE_ME@localhost:5433/verora?schema=public
# CHAIN=foundry
# RPC_URL=http://localhost:8545
# CONFIRMATIONS=0
# PUBLIC_BASE_URL=http://localhost:4100
# CORS_ORIGINS=http://localhost:4101
# SIWE_DOMAINS=localhost:4101
# SWAGGER_ENABLED=true
# ALLOW_PRIVATE_AGENT_ENDPOINTS=true
# TRUST_PROXY_HOPS=0
